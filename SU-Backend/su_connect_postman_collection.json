            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kagabo Frank\",\n  \"email\": \"frank.kagabo@su.rw\",\n  \"password\": \"Password123!\",\n  \"role\": \"field_officer\",\n  \"region\": \"Eastern Province\",\n  \"department\": \"Youth\",\n  \"position\": \"Field Officer\",\n  \"phone\": \"+250788112233\",\n  \"location\": \"Rwamagana\"\n}"
            },
            "url": {
