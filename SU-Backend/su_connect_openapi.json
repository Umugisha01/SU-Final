components:
  schemas:
    AiPriorityEnum:
      enum:
      - urgent
      - high
      - medium
      - low
      type: string
      description: |-
        * `urgent` - Urgent
        * `high` - High
        * `medium` - Medium
        * `low` - Low
    AuditLog:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        user_snapshot:
          type: string
          maxLength: 255
        action:
          type: string
          maxLength: 255
        resource:
          type: string
          maxLength: 255
        ip:
          type: string
          maxLength: 45
        severity:
          $ref: '#/components/schemas/SeverityEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - created_at
      - id
      - ip
      - resource
      - user
      - user_snapshot
    CategoryEnum:
      enum:
      - Financial
      - Equipment
      - Spiritual
      - Technical
      - Training
      type: string
      description: |-
        * `Financial` - Financial
        * `Equipment` - Equipment
        * `Spiritual` - Spiritual
        * `Technical` - Technical
        * `Training` - Training
    Notification:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        type:
          $ref: '#/components/schemas/NotificationTypeEnum'
        title:
          type: string
          maxLength: 255
        message:
          type: string
        icon:
          type: string
          nullable: true
          maxLength: 50
        read:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - message
      - title
      - type
    NotificationTypeEnum:
      enum:
      - report
      - support
      - prayer
      - deadline
      - system
      - other
      type: string
      description: |-
        * `report` - Report Update
        * `support` - Support Request
        * `prayer` - Prayer Commitment
        * `deadline` - Deadline Reminder
        * `system` - System Alert
        * `other` - Other Notification
