    SupportRequest:
      type: object
      description: Serializer for creating, retrieving, and updating support tickets.
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        category:
          $ref: '#/components/schemas/CategoryEnum'
        description:
          type: string
        urgency:
          $ref: '#/components/schemas/UrgencyEnum'
        status:
          allOf:
          - $ref: '#/components/schemas/SupportStatusEnum'
          readOnly: true
        requester:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        assigned_to:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        deadline:
          type: string
          format: date
          readOnly: true
          nullable: true
        region:
          type: string
          readOnly: true
        comments:
          type: array
          items:
            $ref: '#/components/schemas/SupportComment'
          readOnly: true
        recipients:
          type: array
          items:
            $ref: '#/components/schemas/User'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        ai_priority:
          readOnly: true
          nullable: true
          description: |-
            AI-assigned priority based on content analysis

            * `urgent` - Urgent
            * `high` - High
            * `medium` - Medium
            * `low` - Low
          oneOf:
          - $ref: '#/components/schemas/AiPriorityEnum'
          - $ref: '#/components/schemas/NullEnum'
        ai_priority_confidence:
          type: integer
          readOnly: true
          nullable: true
          description: Confidence score 0-100
        ai_priority_reason:
          type: string
          readOnly: true
          nullable: true
          description: Why AI assigned this priority
        ai_analyzed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        manual_priority_override:
          type: boolean
      required:
      - ai_analyzed_at
      - ai_priority
      - ai_priority_confidence
      - ai_priority_reason
      - assigned_to
      - category
      - comments
      - created_at
      - deadline
      - description
      - id
      - recipients
      - region
      - requester
      - status
      - title
      - updated_at
    SupportRequestRequest:
      type: object
